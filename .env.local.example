# Snatcharr — local development
# cp .env.local.example .env.local
# Set AUTH_SECRET, then: npm run dev


AUTH_URL=http://localhost:3000

# Generate: openssl rand -base64 32
AUTH_SECRET=


# SQLite database (relative to project root)
DATABASE_URL=file:./data/snatcharr.db

# Show System → Debug tab (seeds + mock Search/Grab). In development this is on by default.
# SNATCHARR_DEBUG=1
# SNATCHARR_DEBUG=0
