# Snatcharr — local development
# cp .env.local.example .env.local
# Set AUTH_SECRET, then: npm run dev

# ── Required ─────────────────────────────────────────────────────────────────

NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=

# ── Paths (optional — defaults work for dev) ─────────────────────────────────

# SQLite database (relative to project root)
DATABASE_URL=file:./data/snatcharr.db
