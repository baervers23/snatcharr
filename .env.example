# Snatcharr — Docker / production
# cp .env.example .env
# Edit values, then: docker compose up -d --build


# Public URL (no trailing slash)
AUTH_URL=http://localhost:3000

# Session signing — generate: openssl rand -base64 32
AUTH_SECRET=

# Match the owner of your host folders: id -u / id -g
# Synology and many NAS images often use 568.

PUID=568
PGID=568

# Fixed in docker-compose.yml: ./snatcharr-data → /app/data, host download path → /downloads


# Host port → container 3000
PORT=3000

# App version label (docker build arg / image LABEL) — keep in sync with package.json
APP_VERSION=0.9.3

# SQLite (default: /app/data/snatcharr.db inside the container)
DATABASE_URL=file:/app/data/snatcharr.db

# Optional Redis (only with: docker compose --profile redis up -d)
# REDIS_DATA_HOST=./data/redis
