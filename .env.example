# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production #production or development
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=111111111111111111111111111

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default — just keep file: prefix)
DATABASE_URL=file:./data/snatcharr.db

# PostgreSQL (optional — for production scaling)
# DATABASE_URL=postgresql://snatcharr:password@db:5432/snatcharr



# ── Redis (optional — for distributed rate limiting in production) ────────────
# REDIS_URL=redis://redis:6379



# ── Email (optional — for notifications) ─────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=snatcharr@example.com

# ── Security ──────────────────────────────────────────────────────────────────
# Rate limit window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_SEARCH=30




# useless?

# ── Data Directory ────────────────────────────────────────────────────────────
#DATA_DIR_HOST=./snatcharr/data

# ── Downloads ─────────────────────────────────────────────────────────────────
#DOWNLOAD_DIR_HOST=./snatcharr/downloads